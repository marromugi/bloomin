{
  "name": "bloomin-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "openapi": "tsx scripts/write-openapi.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "eslint .",
    "test": "vitest run",
    "signature-vectors": "tsx scripts/write-signature-vectors.ts",
    "db:generate": "drizzle-kit generate --name init",
    "db:check": "drizzle-kit generate --name init && tsx scripts/check-migrations.ts",
    "test:scripts": "tsx --test scripts/*.test.ts",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.20",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^24.19.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12",
    "wrangler": "4.166.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
